# RetailPulse AI - Environment Configuration Example

# Application
PROJECT_NAME="RetailPulse AI"
TAGLINE="Predict Demand. Prevent Stockouts. Optimize Inventory."
PORT=8000
ENVIRONMENT=production

# Database (PostgreSQL for cloud, or SQLite for zero-config local development)
DATABASE_URL=sqlite:///./retailpulse.db
# DATABASE_URL=postgresql://retailadmin:password@localhost:5432/retailpulse

# Security & JWT Secrets (Change in production)
SECRET_KEY=replace-with-a-random-secure-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS Cloud Integration (Optional for local demo mode)
AWS_REGION=us-east-1
AWS_S3_BUCKET=retailpulse-ai-cloud-storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
